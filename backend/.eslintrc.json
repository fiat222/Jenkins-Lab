{
    "root": true,
    "env": {
      "node": true,
      "es2022": true,
      "jest": true
    },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "plugins": ["security"],
    "extends": ["plugin:security/recommended-legacy"],
    "ignorePatterns": ["dist/", "coverage/", "node_modules/", "*.spec.ts"]
  }
