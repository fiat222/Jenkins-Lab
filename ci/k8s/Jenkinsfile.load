// Saturation job for Lab 09: each build holds one pod from the k8s-node template.
pipeline {
    agent { label 'k8s-node' }

    parameters {
        // Distinct values stop Jenkins from merging identical queued builds into one.
        string(name: 'RUN_ID', defaultValue: 'manual', description: 'Unique id per triggered build')
        string(name: 'HOLD_SECONDS', defaultValue: '180', description: 'How long each build occupies its pod')
    }

    // A new job's first run has no parameters yet, so fall back to the defaults.
    environment {
        RUN_ID = "${params.RUN_ID ?: 'first-run'}"
        HOLD_SECONDS = "${params.HOLD_SECONDS ?: '180'}"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Hold pod') {
            steps {
                container('node') {
                    sh 'echo "run ${RUN_ID} on $(hostname)"; node --version; sleep "${HOLD_SECONDS}"'
                }
            }
        }
    }
}
